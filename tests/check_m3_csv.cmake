if(NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Pass OUTPUT_DIR")
endif()
foreach(name IN ITEMS eigenvalues.csv tm_reference.csv mode_diagnostics.csv
                      field_candidate_1.csv run_metadata.txt)
  set(f "${OUTPUT_DIR}/${name}")
  if(NOT EXISTS "${f}")
    message(FATAL_ERROR "Missing M3 artifact: ${f}")
  endif()
  file(SIZE "${f}" length)
  if(length LESS 30)
    message(FATAL_ERROR "M3 artifact unexpectedly small: ${f}")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/run_metadata.txt" meta)
if(NOT meta MATCHES "numerical_kernel=[0-9]+")
  message(FATAL_ERROR "Missing numerical kernel diagnostics")
endif()
if(NOT meta MATCHES "positive_candidates_are_not_validated_physical_modes")
  message(FATAL_ERROR "Missing physical validity disclaimer")
endif()
file(STRINGS "${OUTPUT_DIR}/eigenvalues.csv" spectrum)
list(LENGTH spectrum eigen_rows)
if(eigen_rows LESS 12)
  message(FATAL_ERROR "Eigenvalue CSV has too few rows")
endif()
file(READ "${OUTPUT_DIR}/tm_reference.csv" refs)
if(NOT refs MATCHES "1,1,")
  message(FATAL_ERROR "TM11 analytical reference not present")
endif()
message(STATUS "PASS M3 eigenvalues, analytic reference, modal fields and metadata")
